digraph G {
graph [fontname="DejaVu Sans", fontsize=16, label=<<B>Diagrama de clases del dominio · FeriaPlace v1.0</B>>, labelloc=t, rankdir=LR, bgcolor=white, pad=0.3, nodesep=0.5, ranksep=0.8 ];
node [fontname="DejaVu Sans", fontsize=11, color="#1F4E79"];
edge [fontname="DejaVu Sans", fontsize=10, color="#444444"];
node [shape=plaintext];
Usuario [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1F4E79" BGCOLOR="#F3F7FB"><TR><TD BGCOLOR="#DCE8F4" ALIGN="CENTER"><B>Usuario</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id : int<BR/>nombre : string<BR/>email : string {único}<BR/>telefono : string<BR/>passwordHash : string (bcrypt)<BR/>rol : Rol<BR/>estado : EstadoCuenta<BR/>motivoRegistro : string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">registrar()<BR/>iniciarSesion() : JWT<BR/>cambiarPassword()<BR/>aprobar() / rechazar()</TD></TR></TABLE>>];
Feria [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1F4E79" BGCOLOR="#F3F7FB"><TR><TD BGCOLOR="#DCE8F4" ALIGN="CENTER"><B>Feria</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id : int<BR/>nombre, lugar, comuna : string<BR/>latitud, longitud : decimal<BR/>perimetro : Punto[*]<BR/>fechaInicio, fechaCierre : date<BR/>horario : string<BR/>precioPuesto : int<BR/>ancho, alto : int (celdas)<BR/>publicada : bool</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">crear(cantidadPuestos)<BR/>guardarPlano(puestos, elementos)<BR/>ocupacion() : Reporte</TD></TR></TABLE>>];
Puesto [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1F4E79" BGCOLOR="#F3F7FB"><TR><TD BGCOLOR="#DCE8F4" ALIGN="CENTER"><B>Puesto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id : int<BR/>codigo : string {único por feria}<BR/>zona : string<BR/>tamano : Tamano<BR/>estado : EstadoPuesto<BR/>posX, posY, ancho, alto : int<BR/>precio : int [0..1]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">precioFinal() : int<BR/>estaDisponible() : bool</TD></TR></TABLE>>];
ElementoPlano [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1F4E79" BGCOLOR="#F3F7FB"><TR><TD BGCOLOR="#DCE8F4" ALIGN="CENTER"><B>ElementoPlano</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id : int<BR/>tipo : TipoElemento<BR/>etiqueta : string<BR/>color : string<BR/>direccion : Direccion [0..1]<BR/>posX, posY, ancho, alto : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
Solicitud [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1F4E79" BGCOLOR="#F3F7FB"><TR><TD BGCOLOR="#DCE8F4" ALIGN="CENTER"><B>Solicitud</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id : int<BR/>rubro : string<BR/>zonaPreferida : string<BR/>tamanoPreferido : Tamano<BR/>comentario : string<BR/>estado : EstadoSolicitud<BR/>monto : int<BR/>estadoPago : EstadoPago<BR/>pagadoEn : datetime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">enviar()<BR/>asignar(puesto)  «transacción + FOR UPDATE»<BR/>rechazar(motivo)<BR/>marcarPago(estado, monto)<BR/>credencial() : CredencialQR</TD></TR></TABLE>>];
Notificacion [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1F4E79" BGCOLOR="#F3F7FB"><TR><TD BGCOLOR="#DCE8F4" ALIGN="CENTER"><B>Notificacion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id : int<BR/>titulo, mensaje : string<BR/>enlace : string<BR/>leida : bool<BR/>enviadaCorreo : bool</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">marcarLeida()</TD></TR></TABLE>>];
CredencialQR [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1F4E79" BGCOLOR="#F3F7FB"><TR><TD BGCOLOR="#DCE8F4" ALIGN="CENTER"><B>CredencialQR</B><BR/><FONT POINT-SIZE="9">«valor, no se guarda»</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">codigo : string (id + firma HMAC)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">verificar() : en regla | observada</TD></TR></TABLE>>];
Enums [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1F4E79" BGCOLOR="#F3F7FB"><TR><TD BGCOLOR="#EEEEEE" ALIGN="CENTER"><B>Enumeraciones</B><BR/><FONT POINT-SIZE="9">«enumeration»</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Rol: comerciante | administrador<BR/>EstadoCuenta: pendiente | aprobado | rechazado<BR/>EstadoSolicitud: pendiente | confirmada | rechazada<BR/>EstadoPago: pendiente | pagado<BR/>EstadoPuesto: disponible | ocupado<BR/>Tamano: pequeno | mediano | grande</TD></TR></TABLE>>];

Usuario -> Solicitud [arrowhead=none, label="envía", taillabel="1", headlabel="0..*"];
Usuario -> Notificacion [arrowtail=diamond, dir=back, label="recibe", taillabel="1", headlabel="0..*"];
Feria -> Puesto [arrowtail=diamond, dir=back, label="contiene", taillabel="1", headlabel="1..*"];
Feria -> ElementoPlano [arrowtail=diamond, dir=back, label="dibuja", taillabel="1", headlabel="0..*"];
Solicitud -> Feria [arrowhead=vee, label="postula a", taillabel="0..*", headlabel="1"];
Solicitud -> Puesto [arrowhead=vee, label="asignado / preferido", taillabel="0..*", headlabel="0..1"];
Solicitud -> CredencialQR [style=dashed, arrowhead=vee, label="genera"];
Solicitud -> Notificacion [style=dashed, arrowhead=vee, label="provoca"];
{rank=same; Usuario; Feria}
}
